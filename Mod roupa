local clothesEnabled = false
local originalShirtId = ""
local originalPantsId = ""

clothesBtn.MouseButton1Click:Connect(function()
	clothesEnabled = not clothesEnabled
	local char = player.Character
	if not char then return end

	local shirt = char:FindFirstChildOfClass("Shirt")
	local pants = char:FindFirstChildOfClass("Pants")

	if clothesEnabled then
		clothesBtn.Text = "MOD ROUPA: ON"
		TweenService:Create(clothesBtn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(220, 40, 50)}):Play()

		-- Salva as roupas que você já tem antes de aplicar a nova
		if shirt then
			originalShirtId = shirt.ShirtTemplate
		else
			originalShirtId = ""
		end
		
		if pants then
			originalPantsId = pants.PantsTemplate
		else
			originalPantsId = ""
		end

		if not shirt then
			shirt = Instance.new("Shirt", char)
		end
		if not pants then
			pants = Instance.new("Pants", char)
		end

		-- Aplica a roupa personalizada/estilosa
		shirt.ShirtTemplate = "rbxassetid://14408044719"
		pants.PantsTemplate = "rbxassetid://14408047702"
	else
		clothesBtn.Text = "MOD ROUPA: OFF"
		TweenService:Create(clothesBtn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(45, 45, 50)}):Play()

		-- Restaura exatamente as roupas que você já tinha (e apaga a customizada)
		if shirt then
			shirt.ShirtTemplate = originalShirtId
		end
		if pants then
			pants.PantsTemplate = originalPantsId
		end
	end
end)

